# Generates SplittrBuildInfo.h at BUILD time (issue #28): a configure-time
# hash goes stale the moment a commit lands without a reconfigure, and "which
# build is actually installed?" is the first question of every bug report.
# Written via copy_if_different so an unchanged identity rebuilds nothing.

execute_process(COMMAND git -C "${SRC_DIR}" rev-parse --short HEAD
                OUTPUT_VARIABLE gitHash OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET)

if(NOT gitHash)
    set(gitHash "unknown")
endif()

execute_process(COMMAND git -C "${SRC_DIR}" status --porcelain
                OUTPUT_VARIABLE gitStatus ERROR_QUIET)

if(gitStatus)
    set(gitHash "${gitHash}+dirty")
endif()

string(TIMESTAMP buildTime "%Y-%m-%d %H:%M")

set(tmp "${OUT_DIR}/SplittrBuildInfo.h.tmp")
file(WRITE "${tmp}" "#pragma once

// Generated by cmake/BuildInfo.cmake at build time — do not edit, do not
// commit. Only the diagnostics report includes this, so a new commit rebuilds
// one translation unit.
#define SPLITTR_GIT_HASH \"${gitHash}\"
#define SPLITTR_BUILD_TIME \"${buildTime}\"
")

execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different
                "${tmp}" "${OUT_DIR}/SplittrBuildInfo.h")
file(REMOVE "${tmp}")
